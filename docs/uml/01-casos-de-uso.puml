@startuml casos-de-uso
!include _estilo.iuml
left to right direction
title Casos de uso · Control de incidencias de mantenimiento
actor "Usuario" as U
actor "Coordinador" as C
actor "Técnico" as T
rectangle "Sistema de incidencias" {
  usecase "Iniciar sesión\n(RF1)" as UC0
  usecase "Registrar incidencia\n(RF2, RF3)" as UC1
  usecase "Consultar incidencias\n(RF4, RF5)" as UC2
  usecase "Asignar técnico\n(RF6, RF7)" as UC3
  usecase "Actualizar estado\n(RF8)" as UC4
  usecase "Consultar seguimiento\n(RF9)" as UC5
  usecase "Registrar cambio\nen historial" as UC6
}
U --> UC0
U --> UC1
U --> UC2
U --> UC5
C --> UC0
C --> UC2
C --> UC3
C --> UC5
T --> UC0
T --> UC2
T --> UC4
T --> UC5
UC1 ..> UC6 : <<include>>
UC3 ..> UC6 : <<include>>
UC4 ..> UC6 : <<include>>
UC1 ..> UC0 : <<include>>
@enduml
